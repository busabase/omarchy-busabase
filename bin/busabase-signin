#!/usr/bin/env bash
# busabase-signin — what "Sign in to Busabase" runs inside Omarchy's floating
# terminal: the Busabase logo under Omarchy's, then `busabase-cli login`, which
# writes ~/.busabase/.env for the widget, the CLI and your agents alike.
set -uo pipefail

# Whatever the CLI creates while signing in (~/.busabase, .env) is born owner-only,
# even when this shell's umask is 022 and the CLI itself creates files before it
# tightens them (busabase-cli before 0.99.2 did exactly that).
umask 077

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  teal=$'\e[38;5;43m' off=$'\e[0m'
else
  teal="" off=""
fi

# Same lettering as the `busabase server` and `busabase-cli` splash.
printf '%s' "$teal"
cat <<'LOGO'
  ____                  _
 | __ ) _   _ ___  __ _| |__   __ _ ___  ___
 |  _ \| | | / __|/ _` | '_ \ / _` / __|/ _ \
 | |_) | |_| \__ \ (_| | |_) | (_| \__ \  __/
 |____/ \__,_|___/\__,_|_.__/ \__,_|___/\___|
LOGO
printf '%s\n' "$off"

if command -v busabase-cli >/dev/null 2>&1; then
  exec busabase-cli login
fi
# Pinned: npm versions are immutable, so this runs exactly the reviewed release.
# Bump deliberately with the plugin, never float to @latest.
BUSABASE_CLI_VERSION="0.99.2"
exec npx -y "busabase-cli@${BUSABASE_CLI_VERSION}" login
