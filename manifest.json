{
  "schemaVersion": 1,
  "id": "busabase",
  "name": "Busabase",
  "version": "0.2.2",
  "author": "Busabase",
  "license": "MIT",
  "description": "Your agents' work, kept. See what Claude Code and Codex saved to Busabase today, with a +1 in the bar as it lands, and teach your agents Busabase in one switch. Cloud or local.",
  "homepage": "https://busabase.com/omarchy-plugin",
  "repository": "https://github.com/busabase/omarchy-busabase",
  "keywords": ["busabase", "agents", "claude-code", "codex", "skills", "database", "knowledge-base"],
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "Busabase",
    "description": "What you and your agents kept in Busabase today",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 60,
      "showCount": true,
      "keepSessions": false,
      "keepSessionsMinMinutes": 10
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "How often to check Busabase (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "showCount",
        "type": "boolean",
        "label": "Show today's kept count next to the icon",
        "defaultValue": true
      },
      {
        "key": "keepSessions",
        "type": "boolean",
        "label": "Offer to keep finished Claude Code / Codex sessions in Busabase",
        "defaultValue": false
      },
      {
        "key": "keepSessionsMinMinutes",
        "type": "integer",
        "label": "Only offer for sessions at least this long (minutes)",
        "min": 0,
        "max": 240,
        "step": 5,
        "defaultValue": 10
      }
    ]
  }
}
